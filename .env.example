# GEMINI_API_KEY: Required for server-side Gemini AI recommendations, routine planning, and multilingual assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# WAQI_API_TOKEN: Optional World Air Quality Index token.
# When omitted, AirCare AI uses the keyless Open-Meteo Air Quality API, or manual/demo mode if offline.
WAQI_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
